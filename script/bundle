#!/bin/zsh
# Builds target/release/bundle/Naru.app: the screen bundled into naru-desktop, naru-d beside it.
# Building never starts the app. Opening it with the real HOME replaces the running Naru's token
# and socket, so the old Naru is quit first (CLAUDE.md "교체").
set -euo pipefail
root=${0:A:h:h}
# NARU_SIGN_IDENTITY picks the codesigning identity; otherwise the first Apple Development one in
# the keychain.
identity=${NARU_SIGN_IDENTITY:-$(security find-identity -v -p codesigning | sed -n 's/.*"\(Apple Development: [^"]*\)".*/\1/p' | head -1)}
[[ -n $identity ]] || {
  print -u2 "no Apple Development signing identity in the keychain; set NARU_SIGN_IDENTITY"
  exit 1
}
app=$root/target/release/bundle/Naru.app

security find-identity -v -p codesigning | grep -qF "$identity" || {
  print -u2 "signing identity not found: $identity"
  exit 1
}
(cd "$root/web" && PATH=/opt/homebrew/bin:$PATH ./node_modules/.bin/tsc --noEmit && PATH=/opt/homebrew/bin:$PATH ./node_modules/.bin/vite build)
# The screen is compiled into naru-desktop; touching its source makes cargo embed the new build.
touch "$root"/desktop/src-tauri/src/*.rs
cargo build --manifest-path "$root/Cargo.toml" --release -p naru-d
cargo build --manifest-path "$root/Cargo.toml" --release -p naru-desktop --features custom-protocol

version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/desktop/src-tauri/Cargo.toml" | head -1)
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$root/target/release/naru-desktop" "$root/target/release/naru-d" "$app/Contents/MacOS/"
cp "$root/desktop/src-tauri/icons/icon.icns" "$app/Contents/Resources/icon.icns"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>naru-desktop</string>
  <key>CFBundleIdentifier</key><string>dev.naru.app</string>
  <key>CFBundleName</key><string>Naru</string>
  <key>CFBundleDisplayName</key><string>Naru</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
codesign --force --sign "$identity" "$app/Contents/MacOS/naru-d"
codesign --force --sign "$identity" "$app"
codesign --verify --deep --strict "$app"
print "$app"
